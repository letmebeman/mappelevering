logging {
  level  = "info"
  format = "logfmt"
}

loki.source.file "docker" {
  targets = [
    {
      __path__ = "/var/lib/docker/containers/*/*.log",
      job      = "docker",
    },
  ]

  forward_to    = [loki.process.docker.receiver]
  tail_from_end = true

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.process "docker" {
  forward_to = [loki.write.local.receiver]

  stage.docker {}
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
